      "enum": [
        "DRAFT",
        "PLANNING",
        "AWAITING_PLAN_APPROVAL",
        "FORMULATING",
        "AWAITING_SCORE_APPROVAL",
        "CONFIGURING",
        "AWAITING_LAUNCH_APPROVAL",
        "QUEUED",
        "RUNNING",
        "EVALUATING",
        "ANALYSING",
        "AWAITING_REVISION_APPROVAL",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
