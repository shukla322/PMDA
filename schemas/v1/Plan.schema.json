{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "max_jobs": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Jobs",
          "type": "integer"
        },
        "max_seconds_per_job": {
          "default": 600,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds Per Job",
          "type": "integer"
        },
        "max_candidates": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "GenerationStrategy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_type": {
          "enum": [
            "sampling",
            "transfer_learning",
            "staged_learning"
          ],
          "title": "Run Type",
          "type": "string"
        },
        "device": {
          "const": "cpu",
          "default": "cpu",
          "title": "Device",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 42,
          "title": "Seed"
        }
      },
      "required": [
        "run_type",
        "model_sha256"
      ],
      "title": "GenerationStrategy",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "mode": {
          "enum": [
            "infrastructure",
            "research"
          ],
          "title": "Mode",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "required": [
        "identifier",
        "description",
        "mode"
      ],
      "title": "Objective",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "objective": {
      "$ref": "#/$defs/Objective"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "strategy": {
      "$ref": "#/$defs/GenerationStrategy"
    }
  },
  "required": [
    "objective",
    "rationale",
    "strategy"
  ],
  "title": "Plan",
  "type": "object"
}