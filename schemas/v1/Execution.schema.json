{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "campaign": {
      "minLength": 1,
      "title": "Campaign",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "reserved",
        "starting",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "ambiguous"
      ],
      "title": "Status",
      "type": "string"
    },
    "pid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pid"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    }
  },
  "required": [
    "id",
    "campaign",
    "config_sha256",
    "status"
  ],
  "title": "Execution",
  "type": "object"
}